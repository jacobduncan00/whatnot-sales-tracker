{
  "manifest_version": 3,
  "name": "Whatnot Sales Tracker",
  "version": "1.0",
  "description": "Track total sales in Whatnot livestreams",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["*://*.whatnot.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.whatnot.com/live/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injector.js"],
      "matches": ["*://*.whatnot.com/*"]
    }
  ]
}
